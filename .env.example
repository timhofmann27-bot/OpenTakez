# Copy to .env and adjust.

# Access token the app asks for. Leave empty to have one generated on first start; it is
# printed in the logs (docker compose logs opentakez) and stored in the data volume.
OPENTAKEZ_TOKEN=

# Only for instances nobody else can reach: run without any token.
# OPENTAKEZ_ALLOW_NO_TOKEN=true

# Hours before downloaded files are deleted from the server.
OPENTAKEZ_FILE_TTL_HOURS=6

# Downloads running at the same time, and queued + running before new ones are refused.
OPENTAKEZ_MAX_CONCURRENT_JOBS=2
OPENTAKEZ_MAX_QUEUED_JOBS=20

# Largest file in MB that will be downloaded.
OPENTAKEZ_MAX_FILE_MB=2048

# Reinstall the newest yt-dlp on every start (bypasses the pinned version; see README).
OPENTAKEZ_UPDATE_YTDLP=false

# IP of your reverse proxy, whose X-Forwarded-* headers are trusted.
OPENTAKEZ_FORWARDED_ALLOW_IPS=127.0.0.1

# Origins of PWAs hosted elsewhere that may call this server (JSON list).
# OPENTAKEZ_CORS_ORIGINS=["https://pwa.example.com"]

# Host port the app is published on.
OPENTAKEZ_PORT=8000
