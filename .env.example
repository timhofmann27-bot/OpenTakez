# Copy to .env and adjust.

# Access token required by the app. Strongly recommended for any server reachable
# from the internet; otherwise your instance is an open download proxy.
OPENTAKEZ_TOKEN=

# Hours before downloaded files are deleted from the server.
OPENTAKEZ_FILE_TTL_HOURS=6

# Number of downloads that run at the same time.
OPENTAKEZ_MAX_CONCURRENT_JOBS=2

# Update yt-dlp on every container start.
OPENTAKEZ_UPDATE_YTDLP=true

# Host port the app is published on.
OPENTAKEZ_PORT=8000
