<?xml version="1.0" encoding="utf-8"?>
<!-- The OpenTakez mark: a download arrow through the gap of a power ring. Same geometry as
     web/public/logo.svg. It spans 58% of the canvas, so it stays inside the 72dp safe zone
     that adaptive-icon masks may crop to. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <path
        android:pathData="M312,142.6A127.8,127.8 0 1 1 200,142.6"
        android:strokeColor="#A182FD"
        android:strokeWidth="41"
        android:strokeLineCap="round" />
    <path
        android:pathData="M256,127.8V250"
        android:strokeColor="#A182FD"
        android:strokeWidth="41.6"
        android:strokeLineCap="round" />
    <!-- Filled inset triangle plus a round-joined stroke: the arrow head with rounded corners. -->
    <path
        android:pathData="M202.9,242.7H309.1L256,295.8Z"
        android:fillColor="#A182FD"
        android:strokeColor="#A182FD"
        android:strokeWidth="24.4"
        android:strokeLineJoin="round" />
</vector>
