<resources>
    <!-- AppCompat (not plain Material) so AppCompatActivity can apply per-app locales on Android 8-12.
         The Compose theme paints everything; this only sets the window behind it. -->
    <style name="Theme.OpenTakez" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
